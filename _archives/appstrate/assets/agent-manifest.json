{
  "$schema": "https://schemas.afps.dev/v0/agent.schema.json",
  "name": "@SCOPE/CHANGE-ME",
  "version": "1.0.0",
  "type": "agent",
  "schema_version": "0.1",
  "display_name": "Agent Display Name",
  "description": "One-line description",
  "author": "author-name",
  "keywords": [],

  "dependencies": {
    "skills": {},
    "mcp_servers": {},
    "integrations": {}
  },

  "integrations_configuration": {},

  "runtime_tools": ["output", "report"],

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "title": "Question" },
        "document": {
          "type": "string",
          "format": "uri",
          "contentMediaType": "application/pdf",
          "title": "Reference PDF",
          "description": "Uploaded via upload://, available at ./documents/<filename> in the sandbox"
        }
      },
      "required": ["query"]
    },
    "file_constraints": {
      "document": { "accept": "application/pdf,.pdf", "max_size": 33554432 }
    },
    "ui_hints": {
      "query": { "placeholder": "Ask the agent something…" }
    },
    "property_order": ["query", "document"]
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "property_order": []
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Shape of the object passed to output({ data })"
        }
      },
      "required": ["summary"]
    }
  },

  "timeout": 300
}
