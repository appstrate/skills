{
  "$schema": "https://afps.appstrate.dev/schema/v1/flow.schema.json",
  "name": "@SCOPE/CHANGE-ME",
  "version": "1.0.0",
  "type": "agent",
  "schemaVersion": "1.0",
  "displayName": "Agent Display Name",
  "description": "One-line description",
  "author": "author-name",
  "keywords": [],

  "dependencies": {
    "providers": {},
    "skills": {},
    "tools": {}
  },

  "providersConfiguration": {},

  "input": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "propertyOrder": []
    },
    "_comment_file_fields": "To accept an uploaded file: declare a string property with format='uri' + contentMediaType='<mime>', and add a sibling fileConstraints.<propertyName> block (NOT inside schema). All three keys are required together. See references/manifest-schema.md §'File / upload fields'. Example below — uncomment, adapt, then remove _comment_* keys.",
    "_example_with_file_field": {
      "schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "title": "Question" },
          "document": {
            "type": "string",
            "format": "uri",
            "contentMediaType": "application/pdf",
            "title": "Reference PDF",
            "description": "Uploaded via upload://, available at ./documents/<filename> in the sandbox"
          }
        },
        "required": ["query"]
      },
      "fileConstraints": {
        "document": { "accept": "application/pdf,.pdf", "maxSize": 33554432 }
      },
      "propertyOrder": ["query", "document"]
    }
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "propertyOrder": []
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Execution summary"
        }
      },
      "required": ["summary"]
    }
  },

  "timeout": 300,
  "x-outputRetries": 2
}
