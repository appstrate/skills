{
  "$schema": "https://schemas.afps.dev/v0/integration.schema.json",
  "name": "@SCOPE/CHANGE-ME",
  "version": "1.0.0",
  "type": "integration",
  "schema_version": "0.1",
  "display_name": "Integration Display Name",
  "description": "One-line description of the external service this integration reaches.",
  "keywords": [],
  "license": "Apache-2.0",
  "source": {
    "kind": "none"
  },
  "auths": {
    "primary": {
      "type": "api_key",
      "authorized_uris": ["https://api.example.com/**"],
      "credentials": {
        "schema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "API key for the service."
            }
          },
          "required": ["api_key"]
        }
      },
      "delivery": {
        "http": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Bearer ",
          "value": "{$credential.api_key}"
        }
      },
      "_meta": {
        "dev.appstrate/auth": {
          "required": true
        }
      }
    }
  },
  "_meta": {
    "dev.appstrate/package": {
      "author": "author-name"
    },
    "dev.appstrate/api": {
      "auths": {
        "primary": {}
      }
    }
  }
}
